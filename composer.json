{
    "name": "koh/sylius-mcp-oauth",
    "description": "OAuth 2.1 authorization server for MCP clients on Sylius: dynamic client registration, PKCE, and the RFC 8414 / RFC 9728 discovery metadata.",
    "type": "sylius-bundle",
    "license": "MIT",
    "keywords": [
        "sylius",
        "mcp",
        "oauth2",
        "oauth21",
        "pkce",
        "rfc8414",
        "rfc9728",
        "agent"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "homepage": "https://github.com/ohartwig/sylius-mcp-oauth",
    "support": {
        "issues": "https://github.com/ohartwig/sylius-mcp-oauth/issues",
        "source": "https://github.com/ohartwig/sylius-mcp-oauth"
    },
    "require": {
        "php": "^8.5.11",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "doctrine/doctrine-bundle": "^2.19.1",
        "doctrine/orm": "^3.7.4",
        "doctrine/persistence": "^3.0 || ^4.0",
        "koh/sylius-agent-contracts": "^1.1",
        "psr/cache": "^2.0 || ^3.0",
        "psr/log": "^3.0.2",
        "sylius/sylius": "^2.2.9 || ^2.3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/rate-limiter": "^7.4 || ^8.1",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/security-core": "^7.4 || ^8.0",
        "symfony/security-http": "^7.4 || ^8.0",
        "symfony/translation-contracts": "^3.7.1"
    },
    "require-dev": {
        "koh/dev-sylius": "^1.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.0",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpunit/phpunit": "^11.5.57"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusMcpOAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusMcpOAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
